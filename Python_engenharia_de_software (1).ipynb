      "cell_type": "code",
      "source": [
        "def cadastrar_notas():\n",
        "  notas = []\n",
        "\n",
        "  while True:\n",
        "    entrada = input(\"Digite uma nota (ou'sair' para finalizar): \")\n",
        "\n",
        "    if entrada.lower() == 'sair':\n",
        "      break\n",
        "\n",
        "    try:\n",
        "      nota = float(entrada)\n",
        "      if 0 <= nota <= 10:\n",
        "        notas.append(nota)\n",
        "      else:\n",
        "        print(\"Por favor, digite uma nova nota válida entre 0 e 10.\")\n",
        "    except ValueError:\n",
        "      print(\"Entrada inválida! Digite um número ou a palavra 'sair'.\")\n",
        "\n",
        "  return notas\n",
        "\n",
        "def calcular_media(notas):\n",
        "  if len(notas) == 0:\n",
        "    return 0.0\n",
        "\n",
        "  media = sum(notas) / len(notas)\n",
        "  return media\n",
        "\n",
        "def determinar_situacao(media):\n",
        "    if media >= 7.0:\n",
        "        return \"Aprovado\"\n",
        "    else:\n",
        "        return \"Reprovado\"\n",
        "\n",
        "def exibir_relatorio():\n",
        "  print(\"---INÍCIO DO CADASTRO DE NOTAS---\")\n",
        "  lista_de_notas = cadastrar_notas()\n",
        "\n",
        "  if len(lista_de_notas) == 0:\n",
        "    print(\"Nenhuma nota foi cadastrada.\")\n",
        "    return\n",
        "\n",
        "  media_final = calcular_media(lista_de_notas)\n",
        "  situacao_final = determinar_situacao(media_final)\n",
        "\n",
        "  print(\"\\n=================================\")\n",
        "  print(\"        RELATÓRIO FINAL           \")\n",
        "  print(\"==================================\")\n",
        "  print(f\"Notas inseridas: {lista_de_notas}\")\n",
        "  print(f\"Média do aluno: {media_final:.2f}\")\n",
        "  print(f\"Situação do aluno: {situacao_final}\")\n",
        "  print(\"==================================\")\n",
        "exibir_relatorio()\n"
      ],
